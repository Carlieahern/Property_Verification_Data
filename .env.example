# ---- Firebase (from the service account JSON of THIS app's own project) ----
FIREBASE_PROJECT_ID=wave-verification
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@wave-verification.iam.gserviceaccount.com
# Paste the whole private_key value INCLUDING the -----BEGIN/END----- lines
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ---- Admin page passcode ----
ADMIN_KEY=change-me

# ---- Public base URL, used for the links shown on the admin page ----
PUBLIC_BASE_URL=https://property-verification-data.vercel.app
