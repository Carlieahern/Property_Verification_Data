# =====================================================================
#  IMPORTANT: use a NEW, SEPARATE Firebase project for this tool.
#  Do NOT paste the rpm-site-level-assumptions credentials here -- that
#  project holds live company assumption data and this app must have no
#  access path to it whatsoever.
#  Suggested new project name: rpm-property-verification
# =====================================================================

FIREBASE_PROJECT_ID=rpm-property-verification
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@rpm-property-verification.iam.gserviceaccount.com
# Paste the whole private_key value INCLUDING the -----BEGIN/END----- lines, keeping the \n escapes
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ---- Admin page shared passcode (you pick this; needed for import/export/reminders) ----
ADMIN_KEY=change-me-to-something-long

# ---- Email: leave as none until you pick a provider. Everything still works,
#      and each message is recorded so you can confirm it WOULD have sent. ----
EMAIL_PROVIDER=none
EMAIL_FROM="RPM Property Verification <verification@yourdomain.com>"
NOTIFY_EMAIL=carlie.ahern@rpmliving.com
RESEND_API_KEY=
SENDGRID_API_KEY=

# ---- Public base URL, used to build the links inside emails ----
PUBLIC_BASE_URL=https://property-verification.vercel.app

# ---- Protects the /api/remind cron endpoint ----
CRON_SECRET=another-long-random-string
